// https://wicg.github.io/ua-client-hints/#interface
[GenerateToValue]
dictionary NavigatorUABrandVersion {
    DOMString brand;
    DOMString version;
};

[GenerateToValue]
dictionary UADataValues {
    DOMString architecture;
    DOMString bitness;
    sequence<NavigatorUABrandVersion> brands;
    sequence<DOMString> formFactors;
    sequence<NavigatorUABrandVersion> fullVersionList;
    DOMString model;
    boolean mobile;
    DOMString platform;
    DOMString platformVersion;
    DOMString uaFullVersion;
    boolean wow64;
};

[GenerateToValue]
dictionary UALowEntropyJSON {
    sequence<NavigatorUABrandVersion> brands;
    boolean mobile;
    DOMString platform;
};

[Exposed=(Window,Worker)]
interface NavigatorUAData {
    [CachedAccessor] readonly attribute FrozenArray<NavigatorUABrandVersion> brands;
    readonly attribute boolean mobile;
    readonly attribute DOMString platform;
    [NeedsCallerRealm, CreatesPromise] Promise<UADataValues> getHighEntropyValues(sequence<DOMString> hints);
    UALowEntropyJSON toJSON();
};

interface mixin NavigatorUA {
    [SecureContext] readonly attribute NavigatorUAData userAgentData;
};

Navigator includes NavigatorUA;
WorkerNavigator includes NavigatorUA;
